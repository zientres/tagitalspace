;; TagitalSpace plate pricing rules.
;; The input is the six-character plate body encoded as canonical ASCII:
;; Russian А В Е К М Н О Р С Т У Х -> A B E K M H O P C T Y X.
;; Region code is deliberately excluded from price calculation.
;; Return value is denominated in nanotons.

const int tagitalspace_one_ton = 1000000000;

int tagitalspace_is_plate_letter(int value) inline {
    return (value == 65) | (value == 66) | (value == 69) | (value == 75)
        | (value == 77) | (value == 72) | (value == 79) | (value == 80)
        | (value == 67) | (value == 84) | (value == 89) | (value == 88);
}

int tagitalspace_is_digit(int value) inline {
    return (value >= 48) & (value <= 57);
}

int tagitalspace_plate_start_price(slice plate) inline {
    throw_unless(700, slice_bits(plate) == 48);

    int first_letter = plate~load_uint(8);
    int first_digit = plate~load_uint(8);
    int second_digit = plate~load_uint(8);
    int third_digit = plate~load_uint(8);
    int second_letter = plate~load_uint(8);
    int third_letter = plate~load_uint(8);

    throw_unless(701,
        tagitalspace_is_plate_letter(first_letter)
        & tagitalspace_is_digit(first_digit)
        & tagitalspace_is_digit(second_digit)
        & tagitalspace_is_digit(third_digit)
        & tagitalspace_is_plate_letter(second_letter)
        & tagitalspace_is_plate_letter(third_letter)
    );

    int letters_price = 0;
    if (first_letter == third_letter) {
        if (first_letter == second_letter) {
            letters_price = 50;
        } else {
            letters_price = 15;
        }
    }

    int digits_price = 0;
    if (first_digit == third_digit) {
        if (first_digit == second_digit) {
            digits_price = 50;
        } else {
            digits_price = 15;
        }
    }

    int special_price = letters_price + digits_price;
    if (special_price == 0) {
        return 3 * tagitalspace_one_ton;
    }
    return special_price * tagitalspace_one_ton;
}
